# Configurable backend base URL.
# Leave empty to use same-origin /api routes (Vite dev proxy locally or Vercel rewrites in production),
# or set explicitly, e.g. VITE_API_BASE_URL=http://localhost:5187
VITE_API_BASE_URL=

# Supabase Frontend Configuration (Public client; never put secret keys here)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
