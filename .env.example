# Backend Server Configuration (Local Development only; ignored on Vercel)
PORT=5187

# Allowed frontend origin for CORS (comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173

# Supabase Backend Configuration (Server-only; never expose in frontend)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Shared Reception / Staff PIN Hash (Generate with: node backend/scripts/hash-pin.js)
# Expected format: scrypt:<32-character-hex-salt>:<128-character-hex-hash>
RECEPTION_STAFF_PIN_HASH=

# Secret used to sign HttpOnly PIN session cookies and derive privacy-preserving IP keys
# Generate a random 64-character hex secret (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
PIN_SESSION_SECRET=

# Bearer token protecting scheduled backend cron endpoints (e.g. end-of-day cleanup)
CRON_SECRET=

# Optional Professor-Ready Evaluation Demo Access (must be explicitly enabled)
# Never enable in production unless intentionally evaluating with dedicated demo credentials.
DEMO_ACCESS_ENABLED=false
DEMO_RECEPTION_STAFF_PIN=
DEMO_RECEPTION_STAFF_PIN_HASH=
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=
